{
  "name": "topology",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "test ! -f scripts/ensure-postgres.sh || bash scripts/ensure-postgres.sh",
    "dev": "next dev --port 4317 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port ${PORT:-4317} --hostname ${HOST:-127.0.0.1}",
    "setup": "bash scripts/setup.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:seed:e2e": "TOPOLOGY_SEED_MODE=e2e tsx --env-file=.env.local src/db/seed.ts",
    "db:seed:stress": "tsx --env-file=.env.local src/db/seed-stress.ts",
    "db:studio": "drizzle-kit studio",
    "db:perf-fixture": "tsx --env-file=.env.local scripts/perf-fixture.ts",
    "db:perf-bench": "tsx --env-file=.env.local scripts/perf-bench.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.packages.config.ts",
    "test:integration": "tsx scripts/validation/run.ts integration",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest --config vitest.packages.config.ts",
    "test:e2e": "tsx scripts/validation/run.ts e2e",
    "test:all": "npm run test:regression",
    "topology": "tsx packages/cli/src/index.ts",
    "mcp": "npm run start --workspace=@topology/mcp",
    "test:e2e:smoke": "tsx scripts/validation/run.ts smoke",
    "test:e2e:debug": "tsx scripts/validation/run.ts debug",
    "test:sanity": "tsx scripts/validation/run.ts sanity",
    "test:regression": "tsx scripts/validation/run.ts regression",
    "test:release": "tsx scripts/validation/run.ts release",
    "test:live": "tsx scripts/validation/live.ts",
    "test:inventory": "tsx scripts/validation/inventory.ts",
    "test:core": "tsx scripts/validation/run.ts core",
    "test:ops": "tsx scripts/validation/run.ts ops",
    "test:performance": "tsx scripts/validation/run.ts performance",
    "test:python": "PYTHONPATH=packages/pytest-topology/src python3 -m pytest packages/pytest-topology/tests -q -p no:cacheprovider",
    "test:onboarding": "tsx scripts/validation/run.ts onboarding",
    "test:visual": "tsx scripts/validation/run.ts visual",
    "test:lighthouse": "tsx scripts/validation/run.ts lighthouse",
    "test:visual:linux": "tsx scripts/validation/run.ts visual-linux",
    "test:container": "tsx scripts/validation/run.ts container",
    "test:acceptance": "tsx scripts/validation/acceptance.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@topology/cli": "0.1.0",
    "@topology/domain": "0.1.0",
    "@topology/issue-providers": "0.1.0",
    "@topology/mcp": "0.1.0",
    "@topology/plugin-sdk": "0.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.8.3",
    "geist": "^1.7.2",
    "motion": "^13.2.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-aria": "^3.52.1",
    "react-dom": "19.2.8",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "chrome-launcher": "1.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.0.1",
    "lighthouse": "13.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
