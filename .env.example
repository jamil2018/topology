# App
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://127.0.0.1:4317
# Optional dedicated pepper for API token HMAC (defaults to AUTH_SECRET)
# TOPOLOGY_TOKEN_PEPPER=

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://topology:topology@127.0.0.1:54329/topology

# OAuth-first (optional). When unset, login uses email/password (air-gap path).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generic OIDC (Keycloak / Authentik / Okta / Azure AD). All three required to enable.
# AUTH_OIDC_ISSUER=https://idp.example.com/realms/topology
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=
# AUTH_OIDC_NAME=OIDC
# Force air-gap messaging even if OAuth ids are present:
# TOPOLOGY_AIR_GAP=1

# Local demo user (seeded on `npm run db:seed`). Password must be ≥ 12 characters.
DEMO_USER_EMAIL=demo@topology.local
DEMO_USER_PASSWORD=topology-demo
# Refuse seed in production unless set:
# TOPOLOGY_ALLOW_DEMO_SEED=1
# Seed only the first admin (no demo cases/folders/runs):
# TOPOLOGY_SEED_MODE=bootstrap

# CLI / CI / agent: hashed tokens live in api_tokens (Settings → Security).
# Set TOPOLOGY_API_TOKEN when seeding so the plaintext value is hashed into the DB.
# The process env is NOT accepted as a bearer token unless NODE_ENV is not
# production AND TOPOLOGY_ALLOW_ENV_API_TOKEN=1.
# TOPOLOGY_API_TOKEN=
TOPOLOGY_URL=http://127.0.0.1:4317
# TOPOLOGY_ALLOW_ENV_API_TOKEN=1

# Required for inbound GitHub webhooks unless the repository has its own secret.
# TOPOLOGY_GITHUB_WEBHOOK_SECRET=

# Result attachments. Driver: local (default) or s3 (MinIO / R2 / AWS).
ATTACHMENTS_DRIVER=local
ATTACHMENTS_DIR=./data/attachments
# HOST=127.0.0.1
# PORT=4317
# ATTACHMENTS_S3_BUCKET=
# ATTACHMENTS_S3_ENDPOINT=
# ATTACHMENTS_S3_REGION=auto
# ATTACHMENTS_S3_ACCESS_KEY_ID=
# ATTACHMENTS_S3_SECRET_ACCESS_KEY=
# ATTACHMENTS_S3_FORCE_PATH_STYLE=1

# Optional in-app AI provider (default none). Platform works fully without LLM.
# Values: none | openai | anthropic | azure | compatible-local
# TOPOLOGY_AI_PROVIDER=none
# TOPOLOGY_AI_API_KEY=
# TOPOLOGY_AI_MODEL=gpt-4o-mini
# TOPOLOGY_AI_BASE_URL=
# TOPOLOGY_AZURE_OPENAI_DEPLOYMENT=
# TOPOLOGY_AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Issue providers — default mock (no network). Set jira|linear|github|gitlab + credentials to go live.
# Keep tracker secrets server-side only (never ship to the browser or MCP env beyond TOPOLOGY_API_TOKEN).
# Hub persistence stores mock|jira|linear|github|gitlab on linked_issues.provider.
TOPOLOGY_ISSUE_PROVIDER=mock
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
# GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.com
# GITLAB_PROJECT=group/project

# Outbound webhooks (optional env fallback; UI endpoints preferred)
# TOPOLOGY_WEBHOOK_URL=https://hooks.example.com/topology
# TOPOLOGY_WEBHOOK_SECRET=
