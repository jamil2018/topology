{
  "name": "@topology/playwright",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Playwright reporter that uploads Topology execution reports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/topology.git",
    "directory": "packages/playwright-reporter"
  },
  "homepage": "https://github.com/jamil2018/topology/tree/main/packages/playwright-reporter",
  "bugs": {
    "url": "https://github.com/jamil2018/topology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@topology/domain": "0.1.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
