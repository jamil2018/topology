{
  "name": "@topology/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "CLI for Topology CI ingest, execution uploads, and quality queries",
  "type": "module",
  "bin": {
    "topology": "./bin/topology.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/topology.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jamil2018/topology/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/jamil2018/topology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@topology/domain": "0.1.0"
  }
}
