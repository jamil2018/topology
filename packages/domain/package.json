{
  "name": "@topology/domain",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Topology domain helpers: execution protocol, JUnit, coverage, flake, readiness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/topology.git",
    "directory": "packages/domain"
  },
  "homepage": "https://github.com/jamil2018/topology/tree/main/packages/domain",
  "bugs": {
    "url": "https://github.com/jamil2018/topology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.6.2"
  }
}
