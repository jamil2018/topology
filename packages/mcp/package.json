{
  "name": "@topology/mcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "MCP server for Topology cases, runs, results, and issue filing",
  "type": "module",
  "bin": {
    "topology-mcp": "./bin/topology-mcp.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/topology.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/jamil2018/topology/tree/main/packages/mcp",
  "bugs": {
    "url": "https://github.com/jamil2018/topology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run --config ../../vitest.packages.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "tsx": "^4.23.13",
    "zod": "^4.6.2"
  }
}
