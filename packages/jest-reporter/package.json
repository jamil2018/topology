{
  "name": "@topology/jest",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Jest reporter that uploads Topology execution reports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.packages.config.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamil2018/topology.git",
    "directory": "packages/jest-reporter"
  },
  "homepage": "https://github.com/jamil2018/topology/tree/main/packages/jest-reporter",
  "bugs": {
    "url": "https://github.com/jamil2018/topology/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@topology/domain": "0.1.0"
  },
  "peerDependencies": {
    "jest": ">=29"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    }
  }
}
